# Application Settings
APP_NAME=CryptoSwarm
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./cryptoswarm.db

# Security - CHANGE THIS!
SECRET_KEY=change-this-to-a-random-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI API Keys
OPENAI_API_KEY=your-openai-api-key-here
XAI_API_KEY=your-xai-api-key-here
XAI_API_BASE=https://api.x.ai/v1
DEFAULT_AI_PROVIDER=openai

# Kraken Exchange API
KRAKEN_API_KEY=your-kraken-api-key-here
KRAKEN_API_SECRET=your-kraken-api-secret-here
KRAKEN_TESTNET=true

# Trading Configuration
MAX_BOTS=100
MAX_POSITION_SIZE=1000.0
MIN_TRADE_INTERVAL=60

# Evolutionary Swarm Settings
ENABLE_EVOLUTION=true
MUTATION_RATE=0.1
CROSSOVER_RATE=0.3
FITNESS_WINDOW=30
